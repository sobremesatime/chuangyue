{
  "uid": "chuangyue-protection",
  "title": "窗月 · 保护措施与下游健康",
  "description": "限流、熔断、降级是否在工作，以及下游服务的健康状况。这些信号在 HTTP 错误率里看不到（限流返回 429、熔断返回 503 都属于「系统主动拒绝」，需要单独观察），也正是校准配置里阈值（IP 20/s、用户 10/s、熔断 5 次）所需要的真实数据。",
  "tags": ["chuangyue", "protection"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "限流拒绝总数",
      "description": "累计被限流挡下的请求数（IP + 用户两个维度合计）。它是累计计数器，看「涨得快不快」比看绝对值有意义。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(chuangyue_ratelimit_rejected_total)",
          "legendFormat": "拒绝数",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "熔断器打开数",
      "description": "当前处于「打开」状态（值 = 2）的熔断器个数。大于 0 说明某个下游正在持续失败、调用已被快速拒绝——这是最该告警的信号。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(max by (service) (chuangyue_breaker_state) == 2)",
          "legendFormat": "打开中",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "gRPC 出站错误率",
      "description": "网关发出的内部调用里非 OK 的占比（含超时、重试后的最终失败、熔断快速失败）。它是「对外接口为什么变慢 / 变错」的上一层原因——用户看到的错误往往源头在这里。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(chuangyue_grpc_client_requests_total{code!=\"OK\"}[5m])) / clamp_min(sum(rate(chuangyue_grpc_client_requests_total[5m])), 1e-9)",
          "legendFormat": "错误率",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "gRPC 出站调用速率",
      "description": "网关到各下游的调用速率合计。跨服务调用量应当与网关 QPS 同向变化；QPS 不掉而调用量异常升高，通常意味着重试被触发（每次逻辑调用可能变成多次物理尝试）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(chuangyue_grpc_client_requests_total[5m]))",
          "legendFormat": "调用/秒",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "熔断器状态（0 闭合 / 1 半开 / 2 打开）",
      "description": "每个下游一条泳道，颜色即状态：绿=闭合（正常统计失败）、黄=半开（放少量探测）、红=打开（快速失败）。状态迁移的时点最值得对齐——「红色持续了多久、什么时候自己恢复」直接反映熔断阈值定得合不合适。注意熔断器挂在各调用方的 gRPC 客户端侧，因此网关、feed、interaction、search、transcode-worker **都会暴露该指标**（同一个下游可能有多条）：这里按 `service` 取 max 聚合成一条泳道，任一调用方看到某个下游不可用就算它是打开的。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (service) (chuangyue_breaker_state)",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "center",
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "闭合", "color": "green", "index": 0 },
                "1": { "text": "半开", "color": "orange", "index": 1 },
                "2": { "text": "打开", "color": "red", "index": 2 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "限流拒绝速率（按维度）",
      "description": "ip 维度是「同一来源刷太快」，user 维度是「同一账号刷太快」。两个维度都陡增，多半是被压测或脚本打了；只有 ip 涨、user 不涨，则可能是伪造来源或共享出口 IP（NAT）下的正常用户被误伤——这正需要靠真实曲线来放宽阈值。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (dimension) (rate(chuangyue_ratelimit_rejected_total[5m]))",
          "legendFormat": "{{dimension}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gRPC 出站失败（按目标 / 状态码）",
      "description": "只画非 OK 的调用，按被调服务和错误码拆开。Unavailable / DeadlineExceeded / ResourceExhausted 会计入熔断统计；带业务错误码的失败（如参数错误）不计入——下游是活的，只是这次请求本身不合法。区分这两类是读懂熔断行为的关键。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (target, code) (rate(chuangyue_grpc_client_requests_total{code!=\"OK\"}[5m]))",
          "legendFormat": "{{target}} {{code}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gRPC 出站 P99（按目标服务）",
      "description": "调用方视角的下游耗时（含重试等待）。一元调用统一有 5s 上限，因此这条曲线顶到 5s 附近就意味着开始撞超时——那正是熔断开始计数的前兆。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, target) (rate(chuangyue_grpc_client_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{target}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "服务端处理 P99（按服务）",
      "description": "各服务自己被调用时的处理耗时。它与上面的「出站 P99」对照着看：出站高而服务端不高，问题在网络 / 排队；两边一起高，才是服务自身处理慢。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(chuangyue_grpc_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "服务端被调失败（按服务 / 状态码）",
      "description": "服务端视角的非 OK 返回，按服务与状态码拆开。与「出站失败」对照即可判断问题出在哪一跳：出站有失败而对应服务端没有记录，说明请求根本没到达（连接 / 发现 / 熔断开路）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service, method, code) (rate(chuangyue_grpc_server_requests_total{code!=\"OK\"}[5m]))",
          "legendFormat": "{{service}} {{method}} {{code}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "定时任务距上次成功（按任务）",
      "description": "每个周期任务「最近一次成功完成」距今的秒数。告警阈值是动态的：超过 2 × 该任务的调度间隔 + 60s 即视为停摆（见 alerts.yml 的 CronJobStalled）。任务卡死、未被调度、进程被杀都会让这条线持续上升。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - max by (job) (chuangyue_cron_job_last_success_timestamp_seconds)",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "转码任务结果速率（按结果）",
      "description": "转码 Worker 的最终结果速率（success / failed），只统计已经成功回写视频服务的结果。failed 在 15 分钟内出现任意一次就会触发 TranscodeFailed 告警；持续失败通常意味着源文件损坏、编码不支持或磁盘 / 内存不足。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(chuangyue_transcode_jobs_total[5m]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    }
  ]
}
