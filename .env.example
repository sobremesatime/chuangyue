# 环境变量覆盖示例
# 优先级高于配置文件。复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 命名规则：CHUANGYUE_ + 配置路径，用下划线连接，例如 mysql.host -> CHUANGYUE_MYSQL_HOST

CHUANGYUE_APP_ENV=dev
CHUANGYUE_APP_ADDR=:8080
CHUANGYUE_APP_MODE=debug

CHUANGYUE_LOG_LEVEL=debug
CHUANGYUE_LOG_FORMAT=console

CHUANGYUE_MYSQL_HOST=127.0.0.1
CHUANGYUE_MYSQL_PORT=3306
CHUANGYUE_MYSQL_USERNAME=root
CHUANGYUE_MYSQL_PASSWORD=root123456
CHUANGYUE_MYSQL_DATABASE=chuangyue

# 互动域独立库（物理拆库）；留空 host 则回退上面的 mysql 配置
CHUANGYUE_INTERACTION_MYSQL_HOST=127.0.0.1
CHUANGYUE_INTERACTION_MYSQL_PORT=3306
CHUANGYUE_INTERACTION_MYSQL_USERNAME=chy_interaction
CHUANGYUE_INTERACTION_MYSQL_PASSWORD=chy_interaction_pwd
CHUANGYUE_INTERACTION_MYSQL_DATABASE=chuangyue_interaction

CHUANGYUE_REDIS_HOST=127.0.0.1
CHUANGYUE_REDIS_PORT=6379
CHUANGYUE_REDIS_PASSWORD=
CHUANGYUE_REDIS_DB=0

CHUANGYUE_JWT_ACCESS_SECRET=dev-access-secret-please-change
CHUANGYUE_JWT_REFRESH_SECRET=dev-refresh-secret-please-change

# 邮件（默认填 Resend：事务邮件服务商，**无需备案**，免费域名也能用）。
#
# ⚠️ 重要：**本文件不会被自动加载** —— pkg/config 只读 YAML，仓库里没有任何 dotenv 加载逻辑。
#    它的作用只是一份「变量名清单」。要让这些变量真正生效，二选一：
#      ① 启动前在 shell 里导出（PowerShell：$env:CHUANGYUE_MAIL_PASSWORD='re_xxx'）
#      ② 直接填 configs/dev/config.yaml（该文件已被 .gitignore 忽略，本地最省事）
#    生产环境由 K8s Secret 注入（键名对照见 deploy/k8s/base/secret.yaml.example，
#    创建命令见 deploy/k8s/README.md「部署」第 1 步）。
#
# 要切回「不发信、验证码从 user 服务日志里取」：把配置里的 mail.driver 改成 log。
# CHUANGYUE_MAIL_DRIVER=smtp
# CHUANGYUE_MAIL_HOST=smtp.resend.com
# CHUANGYUE_MAIL_PORT=465
# CHUANGYUE_MAIL_USERNAME=resend            # 固定就是 "resend"，不是邮箱地址
# CHUANGYUE_MAIL_TLS=ssl
# 下面填 Resend 的 **API Key**（re_ 开头），不是登录密码
CHUANGYUE_MAIL_PASSWORD=
